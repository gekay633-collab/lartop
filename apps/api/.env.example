NODE_ENV=development
PORT=3333

DATABASE_URL="postgresql://lartop_app:CHANGE_ME@localhost:5433/lartop?schema=public"
DIRECT_DATABASE_URL="postgresql://lartop:CHANGE_ME@localhost:5433/lartop?schema=public"

REDIS_URL="redis://localhost:6380"

JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Producao: usar SOMENTE a origem canonica HTTPS, ex.: https://DOMINIO
# O navegador usa BFF same-origin Next; o CORS nao substitui autorizacao no Fastify.
CORS_ORIGIN="http://localhost:3000"
CLOUDINARY_CLOUD_NAME="CHANGE_ME"
CLOUDINARY_API_KEY="CHANGE_ME"
CLOUDINARY_API_SECRET="CHANGE_ME"
RESEND_API_KEY="CHANGE_ME"
EMAIL_REMETENTE="Lartop <onboarding@resend.dev>"
# Producao: https://DOMINIO. Define links de recuperacao de senha.
# Nunca usar URL temporaria da Vercel apos o novo dominio entrar em uso.
FRONTEND_URL="http://localhost:3000"
# Producao: https://DOMINIO ou um mailto: de contato, conforme configuracao Web Push.
VAPID_SUBJECT="mailto:suporte@example.com"
# Usar somente durante migração de frontend antigo; desativar depois da atualização.
UPLOAD_ASSINATURA_LEGADO=false
